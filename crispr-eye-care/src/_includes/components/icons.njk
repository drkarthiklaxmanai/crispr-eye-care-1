{# 
  Reusable Ophthalmology Icon Macro
  Usage: {{ icons.icon("name", "size") }}
  Example: {{ icons.icon("cataract", "8") }}
#}

{% macro icon(name, size="7") %}
  {% set s = size %}

  {% if name == "cataract" or name == "eye" %}
    <!-- Cataract / Eye Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-{{ s }} h-{{ s }} text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10" />
      <circle cx="12" cy="12" r="3" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8" />
    </svg>

  {% elif name == "lasik" or name == "laser" %}
    <!-- LASIK / Laser Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-{{ s }} h-{{ s }} text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 19v.01" />
    </svg>

  {% elif name == "retina" %}
    <!-- Retina Care Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-{{ s }} h-{{ s }} text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="8" />
      <circle cx="12" cy="12" r="3" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8" />
    </svg>

  {% elif name == "squint" %}
    <!-- Squint / Eye Alignment Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-{{ s }} h-{{ s }} text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8M8 17h8" />
      <circle cx="8" cy="12" r="2" />
      <circle cx="16" cy="12" r="2" />
    </svg>

  {% elif name == "neuro" or name == "brain" %}
    <!-- Neuro-Ophthalmology Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-{{ s }} h-{{ s }} text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m-8-8h16" />
      <circle cx="12" cy="12" r="3" />
    </svg>

  {% elif name == "shield" %}
    <!-- Trust / Ethical Care Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-{{ s }} h-{{ s }} text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 8.944 11.922.42.095.858.143 1.295.143a3 3 0 01.295-.143" />
    </svg>

  {% elif name == "calendar" %}
    <!-- Appointment Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-{{ s }} h-{{ s }} text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2" />
    </svg>

  {% else %}
    <!-- Default Eye Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-{{ s }} h-{{ s }} text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10" />
      <circle cx="12" cy="12" r="3" />
    </svg>
  {% endif %}
{% endmacro %}
